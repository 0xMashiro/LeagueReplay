{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeagueReplay",
  "version": "0.2.0",
  "identifier": "dev.leaguereplay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeagueReplay",
        "visible": false,
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#10161e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "LeagueReplay contributors",
    "license": "MIT",
    "shortDescription": "Local play archive and replay review for League of Legends",
    "resources": {
      "../LICENSE": "LICENSE",
      "../third-party/": "third-party/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
